== BUILD.bazel
# Mini, the runtime of ddtest instrument, written by ddtest instrument bazel.
== DDTEST_INSTRUMENT
version=v1.2.3
contract=1
sdk_name=ddto
== LICENSE
license
== REPO.bazel
== internal/common/BUILD.bazel
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "common",
    srcs = [
        "c.go",
    ],
    importpath = "github.com/DataDog/ddtest/ddto/internal/common",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":common",
    visibility = ["//visibility:public"],
)
== internal/common/c.go
package common
== internal/racy/BUILD.bazel
