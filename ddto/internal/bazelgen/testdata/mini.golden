go_library(
    name = "racy",
    srcs = [
        "r.go",
    ],
    importpath = "github.com/DataDog/ddtest/ddto/internal/racy",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":racy",
    visibility = ["//visibility:public"],
)
== internal/racy/r.go
package racy
