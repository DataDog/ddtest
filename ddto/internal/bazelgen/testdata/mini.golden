== testopt/BUILD.bazel
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "testopt",
    srcs = [
        "new.go",
        "purego.go",
        "race.go",
        "testopt.go",
        "unix.go",
    ],
    importpath = "github.com/DataDog/ddtest/ddto/testopt",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/common",
        "//internal/racy",
    ] + select({
        "@rules_go//go/platform:darwin_amd64": [
            "//internal/unixonly",
        ],
        "@rules_go//go/platform:darwin_arm64": [
            "//internal/unixonly",
        ],
        "@rules_go//go/platform:linux_386": [
            "//internal/unixonly",
        ],
        "@rules_go//go/platform:linux_amd64": [
            "//internal/unixonly",
        ],
        "@rules_go//go/platform:linux_arm64": [
            "//internal/unixonly",
        ],
        "//conditions:default": [],
    }),
)

alias(
    name = "go_default_library",
    actual = ":testopt",
    visibility = ["//visibility:public"],
)
== testopt/new.go
//go:build go1.1 && !go1.26

package testopt
== testopt/purego.go
//go:build purego && !unsafe

package testopt
== testopt/race.go
//go:build race

package testopt

import _ "github.com/DataDog/ddtest/ddto/internal/racy"
== testopt/testopt.go
