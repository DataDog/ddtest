module(name = "ddtest_bazel_basic")

# The same repository names as in WORKSPACE mode, so that one set of BUILD
# files serves both.

# rules_go 0.65.0 raises golang.org/x/mod and golang.org/x/sys in go_deps to
# releases that need Go 1.26; 0.64.0 is the newest that fetches with Go 1.25.
bazel_dep(name = "rules_go", version = "0.64.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "ddtest_bazel_test", version = "0.0.0")
local_path_override(
    module_name = "ddtest_bazel_test",
    path = "../rule",
)

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.host()

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_datadog_dd_trace_go_v2",
    "com_github_datadog_ddtest_ddto",
    "com_github_stretchr_testify",
    "in_gopkg_datadog_dd_trace_go_v1",
    "org_uber_go_goleak",
)

# dd-trace-go: the checked-in .pb.go files, and regenerated BUILD files for
# the datadog-agent modules that ship their own.
go_deps.gazelle_default_attributes(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable"],
)

# Mini's Go API: tests and binaries that use it link the Mini that ddtest
# instrument bazel writes instead of go_deps' copy (docs/bazel.md).
ddtest = use_extension("@ddtest_bazel_test//:extensions.bzl", "ddtest")
use_repo(ddtest, "ddtest_mini")

override_repo(
    go_deps,
    com_github_datadog_ddtest_ddto = "ddtest_mini",
)
