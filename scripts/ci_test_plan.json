{
  "non_product": ["skills/ddtest-onboarding-eval/**"],
  "ignored": [
    "docs/**",
    "README.md",
    "AGENTS.md",
    "ddto/docs/**",
    "ddto/AGENTS.md",
    "ddto/README.md"
  ],
  "shared": [
    "internal/testdrive/jest*.go",
    "internal/testdrive/mocha.go",
    "internal/onboard/jest_command.go",
    "internal/onboard/python_handwritten.go"
  ],
  "suites": {
    "python": {
      "jobs": [
        "pytest-compatibility",
        "testdrive-language-workflow"
      ],
      "inputs": [
        "internal/compatibility/pytest*",
        "internal/framework/pytest*",
        "internal/platform/python*",
        "internal/platform/scripts/python_*",
        "internal/onboard/python*",
        "internal/onboard/instructions/pytest.md",
        "internal/testdrive/python*",
        "internal/testdrive/pytest*",
        "internal/testdrive/scripts/pytest_*"
      ],
      "smoke": [
        {
          "id": "python",
          "runtime": "python",
          "tests": "^TestPublicPythonRubyTestdrives$/^pytest$",
          "required": [
            "TestPublicPythonRubyTestdrives/pytest"
          ],
          "env": {
            "DDTEST_RUN_FRAMEWORK_INTEGRATION_TEST": "1"
          }
        }
      ]
    },
    "ruby": {
      "jobs": [
        "rspec-compatibility",
        "minitest-compatibility",
        "ruby-testdrive"
      ],
      "inputs": [
        "internal/compatibility/rspec*",
        "internal/compatibility/minitest*",
        "internal/framework/rspec*",
        "internal/framework/minitest*",
        "internal/platform/ruby*",
        "internal/platform/scripts/ruby_*",
        "internal/onboard/ruby*",
        "internal/onboard/instructions/ruby*",
        "internal/onboard/python_ruby_parity_test.go",
        "internal/testdrive/ruby*",
        "internal/testdrive/scripts/ruby_*",
        "internal/testdrive/python_ruby_parity_test.go"
      ],
      "smoke": [
        {
          "id": "ruby",
          "runtime": "ruby",
          "tests": "^TestRubyValidationIntegration$/^(rspec|minitest)$",
          "required": [
            "TestRubyValidationIntegration/rspec",
            "TestRubyValidationIntegration/minitest"
          ],
          "env": {
            "DDTEST_RUN_RUBY_INTEGRATION_TEST": "1"
          },
          "setup": [
            [
              "gem",
              "install",
              "datadog-ci",
              "--version",
              "1.40.0",
              "--no-document"
            ],
            [
              "gem",
              "install",
              "rspec",
              "--version",
              "3.13.2",
              "--no-document"
            ],
            [
              "gem",
              "install",
              "minitest",
              "--version",
              "6.0.6",
              "--no-document"
            ],
            [
              "gem",
              "install",
              "rake",
              "--version",
              "13.4.2",
              "--no-document"
            ]
          ]
        }
      ]
    },
    "java": {
      "jobs": [
        "java-testdrive"
      ],
      "inputs": [
        "internal/framework/jvm*",
        "internal/platform/java[._]*",
        "internal/gradle/**",
        "internal/maven/**",
        "internal/onboard/java[._]*",
        "internal/onboard/instructions/java*",
        "internal/testdrive/java[._]*"
      ],
      "smoke": [
        {
          "id": "java-maven",
          "runtime": "java",
          "tests": "^TestJavaValidationIntegration$/^junit4$",
          "required": [
            "TestJavaValidationIntegration/junit4"
          ],
          "env": {
            "DDTEST_RUN_JAVA_INTEGRATION_TEST": "1",
            "DDTEST_JAVA_TRACER_VERSION": "1.67.1",
            "MAVEN_OPTS": "-XX:+TieredCompilation -XX:TieredStopAtLevel=1"
          }
        },
        {
          "id": "java-gradle",
          "runtime": "gradle",
          "tests": "^TestJavaValidationIntegration$/^gradle_junit4$",
          "required": [
            "TestJavaValidationIntegration/gradle_junit4"
          ],
          "env": {
            "DDTEST_RUN_JAVA_INTEGRATION_TEST": "1",
            "DDTEST_JAVA_TRACER_VERSION": "1.67.1",
            "MAVEN_OPTS": "-XX:+TieredCompilation -XX:TieredStopAtLevel=1"
          }
        }
      ]
    },
    "javascript": {
      "jobs": [
        "javascript-platform-compatibility"
      ],
      "inputs": [
        "internal/platform/javascript*",
        "internal/platform/node_options*",
        "internal/platform/scripts/javascript*",
        "internal/framework/javascript*",
        "internal/onboard/javascript*",
        "internal/onboard/node_*",
        "internal/testdrive/javascript*"
      ],
      "smoke": [
        {
          "id": "javascript",
          "runtime": "node",
          "packages": [
            "./internal/compatibility"
          ],
          "tests": "^TestJavaScript(Platform|ActionPreload)Integration$",
          "required": [
            "TestJavaScriptPlatformIntegration",
            "TestJavaScriptActionPreloadIntegration"
          ],
          "dependencies": [
            "dd-trace@6.15.0"
          ],
          "modules": [
            "DDTEST_DD_TRACE_NODE_MODULES"
          ]
        }
      ]
    },
    "jest": {
      "jobs": [
        "jest-compatibility",
        "jest-testdrive-workflow"
      ],
      "depends_on": [
        "javascript"
      ],
      "inputs": [
        "internal/compatibility/jest*",
        "internal/framework/jest*",
        "internal/onboard/jest*",
        "internal/testdrive/jest*"
      ],
      "smoke": [
        {
          "id": "jest",
          "runtime": "node",
          "tests": "^TestPublicJestTestdrive$/^(passing|existing_failure)$",
          "required": [
            "TestPublicJestTestdrive/passing",
            "TestPublicJestTestdrive/existing_failure"
          ],
          "dependencies": [
            "jest@30.5.1",
            "dd-trace@6.15.0",
            "typescript@5"
          ],
          "modules": [
            "DDTEST_JEST_NODE_MODULES"
          ]
        }
      ]
    },
    "vitest": {
      "jobs": [
        "vitest-compatibility",
        "testdrive-vitest-workflow"
      ],
      "depends_on": [
        "javascript"
      ],
      "inputs": [
        "internal/compatibility/vitest*",
        "internal/framework/vitest*",
        "internal/framework/scripts/vitest*",
        "internal/onboard/vitest*",
        "internal/onboard/instructions/vitest.md",
        "internal/testdrive/vitest*",
        "internal/testdrive/scripts/vitest*"
      ],
      "smoke": [
        {
          "id": "vitest",
          "runtime": "node",
          "tests": "^TestPublicVitestRunnerTestdrive$/^mixed_CI_paths$",
          "required": [
            "TestPublicVitestRunnerTestdrive/mixed_CI_paths"
          ],
          "dependencies": [
            "vitest@4.1.11",
            "@vitest/coverage-v8@4.1.11",
            "dd-trace@6.21.0"
          ],
          "modules": [
            "DDTEST_VITEST_NODE_MODULES"
          ],
          "env": {
            "DDTEST_RUN_FRAMEWORK_INTEGRATION_TEST": "1"
          }
        }
      ]
    },
    "mocha": {
      "jobs": [
        "mocha-compatibility",
        "testdrive-mocha-workflow"
      ],
      "depends_on": [
        "javascript"
      ],
      "inputs": [
        "internal/compatibility/mocha*",
        "internal/framework/mocha*",
        "internal/framework/scripts/mocha*",
        "internal/onboard/mocha*",
        "internal/onboard/instructions/mocha.md",
        "internal/testdrive/mocha*",
        "internal/testdrive/scripts/mocha*"
      ],
      "smoke": [
        {
          "id": "mocha",
          "runtime": "node",
          "tests": "^TestPublicMochaTestdrive$/^(passing|existing_failure)$",
          "required": [
            "TestPublicMochaTestdrive/passing",
            "TestPublicMochaTestdrive/existing_failure"
          ],
          "dependencies": [
            "mocha@11.7.6",
            "nyc@17.1.0",
            "c8@12.0.0",
            "dd-trace@6.21.0"
          ],
          "modules": [
            "DDTEST_MOCHA_NODE_MODULES"
          ]
        }
      ]
    },
    "cypress": {
      "jobs": [
        "cypress-compatibility",
        "testdrive-cypress-workflow"
      ],
      "depends_on": [
        "javascript"
      ],
      "inputs": [
        "internal/compatibility/cypress*",
        "internal/framework/cypress*",
        "internal/framework/scripts/cypress*",
        "internal/onboard/cypress*",
        "internal/onboard/instructions/cypress.md",
        "internal/testdrive/cypress*",
        "internal/testdrive/scripts/cypress*",
        "internal/testdrive/cucumber_coverage.go"
      ],
      "smoke": [
        {
          "id": "cypress",
          "runtime": "node",
          "tests": "^TestPublicCypressTestdrive$/^(passing|existing_failure)$",
          "required": [
            "TestPublicCypressTestdrive/passing",
            "TestPublicCypressTestdrive/existing_failure"
          ],
          "dependencies": [
            "cypress@15.1.0",
            "dd-trace@6.20.1",
            "typescript@5.9.3"
          ],
          "modules": [
            "DDTEST_CYPRESS_NODE_MODULES"
          ],
          "xvfb": true
        }
      ]
    },
    "playwright": {
      "jobs": [
        "playwright-compatibility",
        "playwright-latest",
        "testdrive-playwright-workflow"
      ],
      "depends_on": [
        "javascript"
      ],
      "inputs": [
        "internal/compatibility/playwright*",
        "internal/framework/playwright*",
        "internal/framework/scripts/playwright*",
        "internal/framework/cypress.go",
        "internal/onboard/playwright*",
        "internal/onboard/instructions/playwright.md",
        "internal/testdrive/playwright*",
        "internal/testdrive/scripts/playwright*"
      ],
      "smoke": [
        {
          "id": "playwright",
          "runtime": "playwright",
          "tests": "^TestPublicPlaywrightTestdrive$/^(passing|existing_failure)$",
          "required": [
            "TestPublicPlaywrightTestdrive/passing",
            "TestPublicPlaywrightTestdrive/existing_failure"
          ],
          "dependencies": [
            "@playwright/test@1.55.1",
            "dd-trace@6.20.1"
          ],
          "modules": [
            "DDTEST_PLAYWRIGHT_NODE_MODULES"
          ]
        }
      ]
    },
    "cucumber": {
      "jobs": [
        "cucumber-compatibility",
        "cucumber-matrix",
        "testdrive-cucumber-workflow"
      ],
      "depends_on": [
        "javascript"
      ],
      "inputs": [
        "internal/compatibility/cucumber*",
        "internal/framework/cucumber*",
        "internal/onboard/cucumber*",
        "internal/onboard/instructions/cucumber.md",
        "internal/testdrive/cucumber*",
        "internal/testdrive/scripts/cucumber*"
      ],
      "smoke": [
        {
          "id": "cucumber",
          "runtime": "node",
          "tests": "^TestPublicCucumberTestdrive$/^(passing|existing_failure)$",
          "required": [
            "TestPublicCucumberTestdrive/passing",
            "TestPublicCucumberTestdrive/existing_failure"
          ],
          "dependencies": [
            "@cucumber/cucumber@13.3.0",
            "nyc@17.1.0",
            "c8@12.0.0",
            "dd-trace@6.20.1",
            "@istanbuljs/esm-loader-hook@0.3.0",
            "tsx@4.23.15"
          ],
          "modules": [
            "DDTEST_CUCUMBER_NODE_MODULES"
          ]
        }
      ]
    },
    "webdriverio": {
      "jobs": [
        "testdrive-webdriverio-workflow"
      ],
      "depends_on": [
        "javascript"
      ],
      "inputs": [
        "internal/framework/webdriverio*",
        "internal/framework/scripts/webdriverio*",
        "internal/platform/webdriverio*",
        "internal/onboard/webdriverio*",
        "internal/onboard/instructions/webdriverio.md",
        "internal/testdrive/webdriverio*",
        "internal/testdrive/mocha_validation_test.go"
      ],
      "smoke": [
        {
          "id": "webdriverio",
          "runtime": "node",
          "tests": "^TestPublicWebdriverIOTestdrive$/^(passing|existing_failure)$",
          "required": [
            "TestPublicWebdriverIOTestdrive/passing",
            "TestPublicWebdriverIOTestdrive/existing_failure"
          ],
          "dependencies": [
            "@wdio/cli@9.20.0",
            "@wdio/local-runner@9.20.0",
            "@wdio/mocha-framework@9.20.0",
            "@wdio/jasmine-framework@9.20.0",
            "@wdio/spec-reporter@9.20.0",
            "dd-trace@6.20.1"
          ],
          "modules": [
            "DDTEST_WEBDRIVERIO_NODE_MODULES"
          ],
          "env": {
            "DDTEST_CHROME_BINARY": "/usr/bin/google-chrome"
          },
          "xvfb": true
        }
      ]
    },
    "onboarding": {
      "jobs": [
        "onboard-apply-workflow"
      ],
      "depends_on": [
        "javascript",
        "vitest",
        "mocha",
        "cucumber",
        "webdriverio"
      ],
      "inputs": [
        "internal/testdrive/apply*"
      ],
      "additional_inputs": [
        "internal/onboard/**"
      ],
      "smoke": [
        {
          "id": "onboarding",
          "runtime": "node",
          "tests": "^TestPublicOnboardApply$",
          "required": [
            "TestPublicOnboardApply"
          ],
          "dependencies": [
            "vitest@4.1.11",
            "dd-trace@6.20.1"
          ],
          "modules": [
            "DDTEST_VITEST_NODE_MODULES"
          ]
        }
      ]
    }
  }
}
